{
  "expo": {
    "name": "banana",
    "slug": "banana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main_logo.png",
    "scheme": "banana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/main_logo.png",
        "backgroundColor": "#F4DA1F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.minhsangg.banana",
      "permissions": ["INTERNET", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/main_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/main_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4DA1F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/main_logo.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DFVN-Modak.ttf",
            "./assets/fonts/DFVN-GochiHand.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunchInReleaseBuilds": false,
            "buildType": "apk"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22f62ca3-2263-4c7a-8847-0e318d7588e4"
      }
    },
    "owner": "minhsangg"
  }
}
