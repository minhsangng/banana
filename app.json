{
  "expo": {
    "name": "Banana",
    "slug": "banana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "banana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#F4DA1F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.minhsangg.banana",
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [ 
        "expo-splash-screen",
        {
          "image": "./assets/images/favicon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#F4DA1F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DFVN-Modak.ttf",
            "./assets/fonts/DFVN-GochiHand.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunchInReleaseBuilds": false,
            "buildType": "apk"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbcf278b-06ab-46e0-9a53-ea4bfcca6793"
      }
    },
    "owner": "sangminhh"
  }
}
