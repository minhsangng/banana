{
  "expo": {
    "name": "banana",
    "slug": "banana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main-logo.png",
    "scheme": "banana",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/main-logo.png",
        "backgroundColor": "#F4DA1F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/main-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/main-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4DA1F"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DFVN-Modak.ttf",
            "./assets/fonts/DFVN-GochiHand.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
